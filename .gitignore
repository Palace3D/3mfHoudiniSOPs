# Global Ignore
*
!.gitignore
!.gitattributes
!README.md

# Allow the SOP_Read3mf, SOP_Save3mf and packaging directories themselves (but not their contents)
!SOP_Read3mf/
!SOP_Save3mf/
!packaging/

# Ignore everything INSIDE the directories
SOP_Read3mf/*
SOP_Save3mf/*
packaging/*

# Allow ONLY the specific files we need
!SOP_Read3mf/SOP_Read3mf.C
!SOP_Read3mf/SOP_Read3mf.h
!SOP_Read3mf/CMakeLists.txt
!SOP_Read3mf/hdk_read3mf.txt
!SOP_Read3mf/stb_image.h
!SOP_Read3mf/stb_image_write.h
!SOP_Read3mf/tinyxml2.cpp
!SOP_Read3mf/tinyxml2.h
!SOP_Save3mf/SOP_Save3mf.C
!SOP_Save3mf/SOP_Save3mf.h
!SOP_Save3mf/CMakeLists.txt
!SOP_Save3mf/hdk_save3mf.txt
!packaging/palace3d_3mf.json
!packaging/build_release.bat
!packaging/test_package.bat
!packaging/check_package.py
!packaging/triplets/
!packaging/triplets/x64-windows-static-md-v1435.cmake

# build-20.5/, build-22.0/ and dist/ (release builds and zips) stay ignored by the
# first rule. Release zips go on GitHub Releases.
